{
  "name": "novyra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "pnpm --filter @novyra/db run validate",
    "db:generate": "pnpm --filter @novyra/db run generate",
    "db:migrate:dev": "pnpm --filter @novyra/db run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @novyra/db run migrate:deploy",
    "db:studio": "pnpm --filter @novyra/db run studio",
    "db:typecheck": "pnpm --filter @novyra/db run typecheck",
    "db:seed": "pnpm --filter @novyra/core run seed",
    "db:test:prepare": "pnpm --filter @novyra/db run test:prepare",
    "db:test": "pnpm --filter @novyra/db run test:integration"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "turbo": "2.11.7"
  }
}
