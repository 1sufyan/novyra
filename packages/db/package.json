{
  "name": "@novyra/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "validate": "prisma validate",
    "format": "prisma format",
    "generate": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "studio": "prisma studio",
    "test:prepare": "prisma migrate deploy --config prisma.test.config.ts",
    "test:integration": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@novyra/config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.5",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
