{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies"],
  "timezone": "Asia/Karachi",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": { "enabled": true, "schedule": ["before 9am on monday"] },
  "packageRules": [
    {
      "description": "Version policy: wait two weeks after a new minor of framework-level packages (docs/00-tech-stack.md).",
      "matchPackageNames": [
        "next",
        "eslint-config-next",
        "react",
        "react-dom",
        "prisma",
        "@prisma/**",
        "better-auth"
      ],
      "matchUpdateTypes": ["minor", "major"],
      "minimumReleaseAge": "14 days"
    },
    { "groupName": "next", "matchPackageNames": ["next", "eslint-config-next", "@next/**"] },
    { "groupName": "react", "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"] },
    { "groupName": "prisma", "matchPackageNames": ["prisma", "@prisma/**"] },
    {
      "groupName": "lint and format",
      "matchPackageNames": ["eslint", "@eslint/**", "typescript-eslint", "prettier", "globals"]
    },
    { "groupName": "github actions", "matchManagers": ["github-actions"], "pinDigests": true }
  ]
}
