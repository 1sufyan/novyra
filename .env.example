# =============================================================================
# NOVYRA — environment template. Copy to `.env` (git-ignored) and fill in.
# Full reference: docs/09-environment.md
#
#   NEXT_PUBLIC_*  → compiled into browser bundles. Public identifiers only.
#   everything else → server-only. Never expose to the client.
#
# Generate secrets with:  openssl rand -base64 32
# =============================================================================

# --- Core --------------------------------------------------------------------
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Runtime connection (pooled in hosted envs). Local: docker compose Postgres.
DATABASE_URL=postgresql://novyra:novyra@localhost:5432/novyra
# Direct, non-pooled connection used by `prisma migrate`.
DIRECT_DATABASE_URL=postgresql://novyra:novyra@localhost:5432/novyra
# Disposable database for `prisma migrate dev` and drift checks (dev/CI only).
SHADOW_DATABASE_URL=postgresql://novyra:novyra@localhost:5432/novyra_shadow
# Disposable database for `pnpm --filter @novyra/db test:integration`.
TEST_DATABASE_URL=postgresql://novyra:novyra@localhost:5432/novyra_test

DATA_ENCRYPTION_KEY=
INTERNAL_API_SECRET=
CRON_SECRET=
LOG_LEVEL=info

# --- Authentication ----------------------------------------------------------
BETTER_AUTH_SECRET=
ADMIN_BETTER_AUTH_SECRET=
# Optional: Continue with Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Abuse protection (required in staging/production) -----------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Media -------------------------------------------------------------------
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Alternative S3-compatible storage (e.g. Cloudflare R2), when MEDIA_PROVIDER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET_PUBLIC=
# S3_BUCKET_PRIVATE=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# NEXT_PUBLIC_MEDIA_BASE_URL=

# --- Email & messaging -------------------------------------------------------
# resend (staging/production) | smtp (local Mailpit; rejected when APP_ENV=production)
EMAIL_PROVIDER=smtp
EMAIL_FROM="NOVYRA <orders@novyra.pk>"
EMAIL_REPLY_TO=care@novyra.pk
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# WhatsApp Business Platform (Cloud API) — Phase 7
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Payments ----------------------------------------------------------------
# Cash on Delivery and Bank Transfer need no credentials.
# Gateways below are enabled only once their adapter exists AND these are set (Phase 5).
# Exact credential sets are confirmed from each provider's merchant kit.

# JAZZCASH_ENVIRONMENT=sandbox
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=

# EASYPAISA_ENVIRONMENT=sandbox
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=

# PAYFAST_ENVIRONMENT=sandbox
# PAYFAST_MERCHANT_ID=
# PAYFAST_SECURED_KEY=

# SAFEPAY_ENVIRONMENT=sandbox
# SAFEPAY_API_KEY=
# SAFEPAY_SECRET_KEY=
# SAFEPAY_WEBHOOK_SECRET=

# Future international processor (requires an entity in a supported country)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Shipping ----------------------------------------------------------------
# The `manual` carrier needs no credentials. Courier APIs arrive in Phase 6.
# LEOPARDS_ENVIRONMENT=sandbox
# LEOPARDS_API_KEY=
# LEOPARDS_API_PASSWORD=
# POSTEX_API_TOKEN=
# POSTEX_PICKUP_ADDRESS_CODE=
# TCS_API_BASE_URL=
# TCS_CLIENT_ID=
# TCS_CLIENT_SECRET=
# TCS_ACCOUNT_NUMBER=

# --- Analytics ---------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_API_SECRET=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# --- Observability -----------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# CI only (source maps); never set at runtime
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
